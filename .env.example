PORT=3333

DB_HOST=
DB_PORT=
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb

# SSL (obrigatorio na Aiven). Use DB_SSL_CA_PATH (arquivo) ou DB_SSL_CA (conteudo do certificado)
DB_SSL=true
DB_SSL_CA_PATH=certs/ca.pem
# DB_SSL_CA=

# Autenticação. Gere o segredo com: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRES_IN=8h

# API
CORS_ORIGINS=*
TRUST_PROXY=0
